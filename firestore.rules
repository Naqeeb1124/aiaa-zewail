rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // --- Public Content (Read Only for Everyone, Write for Admins) ---
    match /announcements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /events/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /projects/{docId} {
      allow read: if true;
      allow write: if isAdmin();
      
      // Project membership records are private to administrators.
      match /members/{memberId} {
        allow read, write: if isAdmin();
      }
    }

    // --- Join Requests ---
    match /joinRequests/{requestId} {
      // Users can read their own requests, Admins can read all
      allow read: if request.auth != null && (request.auth.uid == requestId.split('_')[0] || isAdmin());
      // Users can create requests for themselves
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Only admins can update status (users can cancel? maybe later)
      allow update: if isAdmin();
      allow delete: if isAdmin() || (request.auth != null && requestId.split('_')[0] == request.auth.uid); 
    }

    // --- User Data ---
    // Users: Read/Write own profile, Read for admins
    match /users/{userId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      // Allow user to write own, OR admin to write (for approving requests/updating profile)
      allow write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // Applications: Read/Write own application
    match /applications/{userId} {
      allow read, write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // Interviews: Read/Write own interview
    match /interviews/{userId} {
      allow read, write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // Registrations: Read/Write own registration
    match /registrations/{regId} {
      // Registrations are private to the registrant and admins.
      allow read: if isAdmin() ||
                    (request.auth != null && request.auth.uid == resource.data.userId);

      // Guest registrations are created by the server-side registration endpoint.
      // Authenticated users can create their own registrations directly.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;

      allow update, delete: if isAdmin() ||
                              (request.auth != null && request.auth.uid == resource.data.userId);
    }

    // Member records are private; public team content is maintained separately.
    match /members/{memberId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // --- Admin & System ---
    // Users may verify their own admin record; admins may read the directory.
    match /admins/{email} {
      allow read: if request.auth != null &&
                    (request.auth.token.email == email || isAdmin());
      allow write: if false;
    }

    // Recruitment Status: Publicly readable
    match /recruitment/status {
      allow read: if true;
      allow write: if isAdmin(); 
    }

    match /opportunities/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /scheduled_emails/{docId} {
      allow read, write: if isAdmin();
    }

    match /contact_requests/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // --- System Logs (Super Admin Only) ---
    match /audit_logs/{docId} {
      allow read: if isAdmin();
      allow write: if false; // Written only via Admin SDK (Server-side)
    }
  }
}